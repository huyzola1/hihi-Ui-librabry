
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UILib = loadstring(game:HttpGet("https://raw.githubusercontent.com/huyzola1/hihi-Ui-librabry/refs/heads/main/source.lua"))()

-- Create window
local Window = UILib:CreateWindow({
    Name = "Example Hub",
    SubTitle = "UILib Showcase",
    Keybind = Enum.KeyCode.RightControl,
    Theme = {
        Accent = Color3.fromRGB(120, 80, 220),
        AccentDark = Color3.fromRGB(90, 55, 180),
        Background = Color3.fromRGB(18, 18, 24),
        Surface = Color3.fromRGB(28, 28, 38),
        Text = Color3.fromRGB(240, 240, 255)
    }
})

-- Tab 1: General
local General = Window:CreateTab("General")

General:CreateSection("Information")

General:CreateLabel("Welcome to the UILib example!")

General:CreateButton({
    Name = "Show Notification",
    Callback = function()
        Window:Notify({
            Title = "Hello",
            Content = "Button clicked successfully!",
            Type = "Success",
            Duration = 3
        })
    end
})

-- Toggle
local AutoEnabled = false

local AutoToggle = General:CreateToggle({
    Name = "Example Toggle",
    CurrentValue = false,
    Callback = function(value)
        AutoEnabled = value
        print("Toggle state:", value)
    end
})

-- Change toggle through code
-- AutoToggle:Set(true)

-- Tab 2: Settings
local Settings = Window:CreateTab("Settings")

Settings:CreateSection("Adjustments")

-- Slider
local SliderValue = 50

local MySlider = Settings:CreateSlider({
    Name = "Example Slider",
    Range = {0, 100},
    Increment = 5,
    CurrentValue = 50,
    Callback = function(value)
        SliderValue = value
        print("Slider value:", value)
    end
})

-- Dropdown
local SelectedMode = "Normal"

local MyDropdown = Settings:CreateDropdown({
    Name = "Select Mode",
    Options = {"Normal", "Fast", "Slow"},
    CurrentOption = "Normal",
    Callback = function(option)
        SelectedMode = option
        print("Selected mode:", option)
    end
})

-- Input
local MyInput = Settings:CreateInput({
    Name = "Player Name",
    PlaceholderText = "Enter text...",
    Callback = function(text, enterPressed)
        print("Input:", text)
        print("Pressed Enter:", enterPressed)
    end
})

-- Keybind
local CurrentKey = Enum.KeyCode.E

local MyKeybind = Settings:CreateKeybind({
    Name = "Action Key",
    CurrentKey = Enum.KeyCode.E,
    Callback = function(key)
        CurrentKey = key
        print("Action key pressed:", key.Name)
    end
})

-- Color picker
local SelectedColor = Color3.fromRGB(120, 80, 220)

local MyColorPicker = Settings:CreateColorPicker({
    Name = "Accent Color",
    DefaultColor = SelectedColor,
    Callback = function(color)
        SelectedColor = color
        print("RGB:", color.R, color.G, color.B)
    end
})

-- Tab 3: System
local System = Window:CreateTab("System")

System:CreateSection("Window Controls")

System:CreateButton({
    Name = "Test Warning",
    Callback = function()
        Window:Notify({
            Title = "Warning",
            Content = "This is a warning notification.",
            Type = "Warning",
            Duration = 4
        })
    end
})

System:CreateButton({
    Name = "Test Error",
    Callback = function()
        Window:Notify({
            Title = "Error",
            Content = "This is an example error.",
            Type = "Error",
            Duration = 4
        })
    end
})

System:CreateButton({
    Name = "Destroy GUI",
    Callback = function()
        Window:Destroy()
    end
})

Window:Notify({
    Title = "UILib Loaded",
    Content = "All example controls have been created.",
    Type = "Success",
    Duration = 4
})
