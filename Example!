			SmoothTween(DismissBtn, { BackgroundTransparency = 1, TextColor3 = Theme.SubText }, 0.15)
		end)

		-- Dismiss Logic (Clean exit animation with height collapse)
		local isDismissing = false
		local function dismiss()
			if isDismissing then return end
			isDismissing = true

			SmoothTween(Scale, { Scale = 0.85 }, 0.2)
			SmoothTween(CardStroke, { Transparency = 1 }, 0.2)
			local slideOut = SmoothTween(Notif, {
				Position = UDim2.new(0, 70, 0, 0),
				BackgroundTransparency = 1,
			}, 0.25)

			for _, child in ipairs(InnerContainer:GetDescendants()) do
				if child:IsA("TextLabel") or child:IsA("ImageLabel") or child:IsA("Frame") or child:IsA("TextButton") then
					pcall(function()
						if child:IsA("TextLabel") then
							SmoothTween(child, { TextTransparency = 1 }, 0.15)
						elseif child:IsA("ImageLabel") then
							SmoothTween(child, { ImageTransparency = 1 }, 0.15)
						end
					end)
				end
			end

			slideOut.Completed:Connect(function()
				if Notif and Notif.Parent then
					local collapse = SmoothTween(Notif, { Size = UDim2.new(1, 0, 0, 0) }, 0.2)
					collapse.Completed:Connect(function()
						Notif:Destroy()
					end)
				end
			end)
		end

		DismissBtn.MouseButton1Click:Connect(dismiss)

		-- Hover to Pause Timer & Elevate Card
		local isHovered = false
		local remainingTime = duration

		Notif.MouseEnter:Connect(function()
			isHovered = true
			SmoothTween(CardStroke, { Transparency = 0.25 }, 0.2)
			SmoothTween(Scale, { Scale = 1.02 }, 0.2)
		end)

		Notif.MouseLeave:Connect(function()
			isHovered = false
			SmoothTween(CardStroke, { Transparency = 0.65 }, 0.2)
			SmoothTween(Scale, { Scale = 1.0 }, 0.2)
		end)

