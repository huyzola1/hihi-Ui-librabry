		SpringTween(Notif, {
			Position = UDim2.new(0, 0, 0, 0),
			BackgroundTransparency = 0.04,
		}, 0.45)
		SpringTween(Scale, { Scale = 1 }, 0.4)

		-- Countdown loop that respects hover state
		task.spawn(function()
			while remainingTime > 0 do
				task.wait(0.1)
				if not Notif or not Notif.Parent or isDismissing then break end
				if not isHovered then
					remainingTime = remainingTime - 0.1
				end
			end
			if Notif and Notif.Parent and not isDismissing then
				dismiss()
			end
		end)

		return {
			Dismiss = dismiss,
		}
	end

	-- ═══════════════════════════════════════════════════════════
	-- DESTROY
	-- ═══════════════════════════════════════════════════════════
	function Window:Destroy()
		for _, conn in ipairs(Window.Connections) do
			if conn.Connected then conn:Disconnect() end
		end
		table.clear(Window.Connections)
		screenGui:Destroy()
		ActiveWindow = nil
	end

	return Window
end

return UILib
